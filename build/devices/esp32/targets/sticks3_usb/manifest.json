{
	"build": {
		"ESP32_SUBCLASS": "esp32s3",
		"USE_USB": "1",
		"SDKCONFIGPATH": "./sdkconfig",
		"PARTITIONS_FILE_FOR_TARGET": "./sdkconfig/partitions.csv",
		"PROGRAMMING_MODE_MESSAGE": "INSTRUCTIONS: Hold the side power button until the board enters USB download mode.",
		"BEFORE_DEBUGGING_MESSAGE": "Press the side power button once if the board needs to wake or restart."
	},
	"include": [
		"$(MODDABLE)/modules/io/manifest.json",
		"$(MODDABLE)/build/devices/esp32/modules/resetReason/manifest.json",
		"$(MODDABLE)/modules/pins/smbus/manifest.json",
		"$(MODDABLE)/modules/pins/digital/manifest.json"
	],
	"modules": {
		"*": [
			"$(MODULES)/pins/i2s/sbc_decoder",
			"$(MODULES)/pins/i2s/dvi_adpcm_decode"
		],
		"setup/target": "./setup-target",
		"sticks3/board": "./sticks3board",
		"m5pm1": "./m5pm1",
		"es8311": "./es8311",
		"pins/audioout-original": "$(MODULES)/pins/i2s/audioout",
		"pins/audioout": "./StickS3AudioOut",
		"embedded:io/audio/out-original": "$(MODULES)/io/audioout/esp32/audioout-esp32",
		"embedded:io/audio/out": "./StickS3IOAudioOut",
		"embedded:io/audio/in-original": "$(MODULES)/io/audioin/esp32/audioin",
		"embedded:io/audio/in": "./StickS3AudioIn"
	},
	"preload": [
		"setup/target"
	],
	"creation": {
		"static": 0,
		"chunk": {
			"initial": 196608,
			"incremental": 65536
		},
		"heap": {
			"initial": 32768,
			"incremental": 8192
		},
		"stack": 1024
	},
	"config": {
		"screen": "",
		"es8311": {
			"volume": 191
		}
	},
	"defines": {
		"i2c": {
			"sda_pin": 47,
			"scl_pin": 48
		},
		"spi": {
			"miso_pin": -1,
			"mosi_pin": 39,
			"sck_pin": 40
		},
		"audioOut": {
			"bitsPerSample": 16,
			"numChannels": 2,
			"sampleRate": 44100,
			"volume_divider": 1,
			"i2s": {
				"num": 0,
				"slot": "I2S_STD_SLOT_BOTH",
				"bitsPerSample": 16,
				"bck_pin": 17,
				"lr_pin": 15,
				"mck_pin": 18,
				"dataout_pin": 14,
				"mclk_multiple": "I2S_MCLK_MULTIPLE_128",
				"left_align": 1,
				"bit_shift": 1
			}
		},
		"audioIn": {
			"sampleRate": 16000,
			"numChannels": 1,
			"bitsPerSample": 16,
			"bufferSize": 131072,
			"i2s": {
				"num": 1,
				"slot": "I2S_STD_SLOT_RIGHT",
				"format_i2s": 1,
				"bck_pin": 17,
				"lr_pin": 15,
				"mck_pin": 18,
				"datain": 16,
				"mclk_multiple": "I2S_MCLK_MULTIPLE_128",
				"bias": 1,
				"multiplier": 8,
				"noise_filter": 48,
				"mono_packed": 1,
				"left_align": 1,
				"bit_shift": 1
			}
		}
	}
}
